# Copy to .env (same folder as docker-compose.yml) and change the password.
# SQL Server needs at least 8 characters with three of: upper case, lower case, digits, symbols (avoid ; and quotes).
SQL_SA_PASSWORD=Change-Me-2026!

# Optional
# SQL_PORT=1434
# SQL_MEMORY_LIMIT_MB=1024
# MILO_PORT=8086
# MILO_ALLOW_REGISTRATION=true
# MILO_BEHIND_PROXY=true
# MILO_PUSH_ENABLED=true
# MILO_PUSH_SUBJECT=mailto:you@example.com

# Sign in with Discord (optional). One Discord application can serve all your apps:
# https://discord.com/developers/applications → your app → OAuth2. Copy the Client ID and (Reset Secret) the Client
# Secret here, and under Redirects add this app's address followed by /signin-discord, e.g.
# https://milo.prometheus-nas.com/signin-discord (one line per address you open Milo at).
# Already have an account? Sign in with your password, then Settings › Account › Link Discord. Someone new can sign up
# with Discord (while MILO_ALLOW_REGISTRATION is on).
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
